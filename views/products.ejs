<%- include('partials/head', { title: t('products.title') }) %>
<body class="page-bg">
<%- include('partials/header') %>
<main id="main" class="container-x pt-12">
  <div class="max-w-2xl">
    <span class="label-mono"><%= lang === 'ka' ? 'მეორე სიცოცხლე' : 'Second life' %></span>
    <h1 class="mt-1 text-3xl font-bold text-forest-900 sm:text-4xl dark:text-white"><%= t('products.title') %></h1>
    <p class="mt-3 text-ink-soft dark:text-forest-300"><%= t('products.subtitle') %></p>
    <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-lime-100 px-3 py-1.5 text-sm text-forest-800 dark:bg-lime-400/15 dark:text-lime-300"><span class="material-symbols-outlined text-base">handyman</span><%= t('products.preorder') %></p>
  </div>
  <% if (products.length) { %>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <% products.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %>
    </div>
  <% } else { %>
    <p class="mt-10 card card-pad text-ink-soft"><%= t('products.empty') %></p>
  <% } %>
</main>
<%- include('partials/footer') %>
