<%- include('partials/head', { title: t('nav.contact') }) %>
<body class="page-bg">
<%- include('partials/header') %>
<main id="main" class="container-x pt-12">
  <div class="max-w-2xl">
    <span class="label-mono"><%= t('nav.contact') %></span>
    <h1 class="mt-1 text-3xl font-bold text-forest-900 sm:text-4xl dark:text-white"><%= t('contact.title') %></h1>
    <p class="mt-3 text-ink-soft dark:text-forest-300"><%= t('contact.subtitle') %></p>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-[1.4fr_1fr]">
    <div class="card card-pad" data-tabs>
      <% if (sent) { %>
        <div class="mb-5 flex items-start gap-3 rounded-xl bg-lime-100 p-4 text-sm text-forest-900 dark:bg-lime-400/15 dark:text-lime-200" role="status"><span class="material-symbols-outlined">check_circle</span><%= t('contact.sent') %></div>
      <% } %>
      <% if (error) { %>
        <div class="mb-5 flex items-start gap-3 rounded-xl bg-red-50 p-4 text-sm text-red-800 dark:bg-red-950/40 dark:text-red-200" role="alert"><span class="material-symbols-outlined">error</span><%= error %></div>
      <% } %>
      <div class="mb-6 inline-flex rounded-full border border-forest-100 bg-mint-50 p-1 dark:border-graphite-600 dark:bg-graphite-900" role="tablist">
        <% [['handin','battery_charging_full','contact.tabHandin'],['contact','mail','contact.tabContact']].forEach(([k, icon, key]) => { %>
          <button type="button" role="tab" data-tab="<%= k %>" aria-selected="<%= tab === k %>" class="nav-link inline-flex items-center gap-1.5 <%= tab === k ? 'active' : '' %>"><span class="material-symbols-outlined text-base"><%= icon %></span><%= t(key) %></button>
        <% }) %>
      </div>

      <% ['handin', 'contact'].forEach(kind => { const f = (form && (tab === kind)) ? form : {}; %>
        <form method="post" action="/contact" data-form="contact" data-sent="<%= t('contact.sent') %>" data-error="<%= t('errors.form') %>" data-panel="<%= kind %>" class="<%= tab === kind ? '' : 'hidden' %> grid grid-cols-1 gap-4 sm:grid-cols-2">
          <input type="hidden" name="type" value="<%= kind %>">
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">
          <label class="field sm:col-span-2"><span class="field-label"><%= t('contact.name') %> *</span><input class="input" name="name" required maxlength="120" value="<%= f.name || '' %>" autocomplete="name"></label>
          <label class="field"><span class="field-label"><%= t('contact.phone') %> *</span><input class="input" name="phone" type="tel" required maxlength="40" value="<%= f.phone || '' %>" autocomplete="tel"></label>
          <label class="field"><span class="field-label"><%= t('contact.email') %></span><input class="input" name="email" type="email" maxlength="120" value="<%= f.email || '' %>" autocomplete="email"></label>
          <% if (kind === 'handin') { %>
            <label class="field"><span class="field-label"><%= t('contact.source') %></span>
              <select class="input" name="battery_source">
                <% sources.forEach(s => { %><option value="<%= s %>" <%= f.battery_source === s ? 'selected' : '' %>><%= t('source.' + s) %></option><% }) %>
              </select>
            </label>
            <label class="field"><span class="field-label"><%= t('contact.city') %></span><input class="input" name="city" maxlength="80" value="<%= f.city || '' %>"></label>
            <label class="field sm:col-span-2"><span class="field-label"><%= t('contact.qty') %></span><input class="input" name="battery_qty" maxlength="200" placeholder="<%= t('contact.qtyPh') %>" value="<%= f.battery_qty || '' %>"></label>
            <label class="field sm:col-span-2"><span class="field-label"><%= t('contact.message') %></span><textarea class="input" name="message" maxlength="3000"><%= f.message || '' %></textarea></label>
          <% } else { %>
            <label class="field sm:col-span-2"><span class="field-label"><%= t('contact.message') %> *</span><textarea class="input" name="message" required maxlength="3000"><%= f.message || '' %></textarea></label>
          <% } %>
          <div class="sm:col-span-2 flex flex-wrap items-center justify-between gap-3">
            <% if (kind === 'handin') { %><p class="max-w-md text-xs text-ink-soft dark:text-forest-300"><span class="material-symbols-outlined mr-1 text-base text-amber-500">warning</span><%= t('contact.safety') %></p><% } else { %><span></span><% } %>
            <button class="btn-lime px-6 py-3"><span class="material-symbols-outlined text-base">send</span><%= t('common.send') %></button>
          </div>
        </form>
      <% }) %>
    </div>

    <aside class="space-y-4">
      <div class="card-dark p-6">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-lime-300"><%= t('contact.info') %></h2>
        <ul class="mt-4 space-y-4 text-sm">
          <li class="flex gap-3"><span class="material-symbols-outlined text-lime-300">call</span><div><div class="text-forest-200/70"><%= t('contact.phone') %></div><a class="font-medium hover:text-lime-300" <% if (telHref) { %>href="<%= telHref %>"<% } %>><%= site.phone %></a></div></li>
          <li class="flex gap-3"><span class="material-symbols-outlined text-lime-300">mail</span><div><div class="text-forest-200/70"><%= t('contact.email') %></div><a class="font-medium hover:text-lime-300" href="mailto:<%= site.email %>"><%= site.email %></a></div></li>
          <li class="flex gap-3"><span class="material-symbols-outlined text-lime-300">location_on</span><div><div class="text-forest-200/70"><%= t('contact.address') %></div><span class="font-medium"><%= L(site, 'address') %></span></div></li>
          <li class="flex gap-3"><span class="material-symbols-outlined text-lime-300">schedule</span><div><div class="text-forest-200/70"><%= t('contact.hours') %></div><span class="font-medium"><%= L(site, 'hours') %></span></div></li>
        </ul>
      </div>
      <div class="card card-pad">
        <h2 class="font-semibold text-forest-900 dark:text-white"><%= lang === 'ka' ? 'რას ვიბარებთ' : 'What we accept' %></h2>
        <ul class="mt-3 grid grid-cols-2 gap-2 text-sm">
          <% [['scooter','electric_scooter'],['ebike','pedal_bike'],['laptop','laptop'],['tool','construction'],['ev','electric_car'],['vape','smoking_rooms']].forEach(([s, icon]) => { %>
            <li class="flex items-center gap-2 rounded-xl bg-mint-50 px-3 py-2 text-forest-800 dark:bg-graphite-900 dark:text-forest-100"><span class="material-symbols-outlined text-forest-500 dark:text-lime-300"><%= icon %></span><%= t('source.' + s) %></li>
          <% }) %>
        </ul>
      </div>
    </aside>
  </div>
</main>
<%- include('partials/footer') %>
