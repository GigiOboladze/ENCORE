<%- include('partials/head', { title: t('order.title') }) %>
<body class="page-bg">
<%- include('partials/header') %>
<main id="main" class="container-x pt-12">
  <div class="max-w-2xl">
    <span class="label-mono"><%= t('nav.order') %></span>
    <h1 class="mt-1 text-3xl font-bold text-forest-900 sm:text-4xl dark:text-white"><%= t('order.title') %></h1>
    <p class="mt-3 text-ink-soft dark:text-forest-300"><%= t('order.subtitle') %></p>
  </div>

  <div class="mt-10 grid gap-8 lg:grid-cols-[1.4fr_1fr]">
    <form method="post" action="/order" class="card card-pad grid gap-4 sm:grid-cols-2">
      <% if (sent) { %>
        <div class="sm:col-span-2 flex items-start gap-3 rounded-xl bg-lime-100 p-4 text-sm text-forest-900 dark:bg-lime-400/15 dark:text-lime-200" role="status"><span class="material-symbols-outlined">check_circle</span><%= t('order.sent') %></div>
      <% } %>
      <% if (error) { %>
        <div class="sm:col-span-2 flex items-start gap-3 rounded-xl bg-red-50 p-4 text-sm text-red-800 dark:bg-red-950/40 dark:text-red-200" role="alert"><span class="material-symbols-outlined">error</span><%= error %></div>
      <% } %>
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">
      <fieldset class="sm:col-span-2">
        <legend class="field-label"><%= t('order.product') %> *</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          <% products.forEach((p, i) => { const checked = form.product_id ? String(form.product_id) === String(p.id) : (selected ? selected === p.slug : i === 0); %>
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-forest-100 p-3 transition has-[:checked]:border-lime-400 has-[:checked]:bg-lime-50 has-[:checked]:ring-4 has-[:checked]:ring-lime-400/20 dark:border-graphite-600 dark:has-[:checked]:bg-lime-400/10">
              <input type="radio" name="product_id" value="<%= p.id %>" class="sr-only" <%= checked ? 'checked' : '' %> required>
              <% if (p.photos[0]) { %><img src="/uploads/<%= p.photos[0] %>" alt="" class="h-14 w-14 shrink-0 rounded-lg object-cover"><% } %>
              <span class="min-w-0">
                <span class="block truncate text-sm font-semibold text-forest-900 dark:text-white"><%= L(p, 'name') %></span>
                <span class="text-xs text-ink-soft dark:text-forest-300"><%= p.price_from ? (lang === 'ka' ? fmt(p.price_from) + ' ₾-დან' : 'from ' + fmt(p.price_from) + ' ₾') : t('common.priceOnRequest') %></span>
              </span>
            </label>
          <% }) %>
        </div>
      </fieldset>
      <label class="field"><span class="field-label"><%= t('order.quantity') %></span><input class="input" type="number" name="quantity" min="1" max="999" value="<%= form.quantity || 1 %>"></label>
      <fieldset class="field">
        <legend class="field-label"><%= t('order.delivery') %></legend>
        <div class="flex gap-2">
          <% [['pickup','storefront','order.pickup'],['delivery','local_shipping','order.deliver']].forEach(([v, icon, key]) => { %>
            <label class="flex flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-xl border border-forest-100 px-3 py-2.5 text-sm transition has-[:checked]:border-lime-400 has-[:checked]:bg-lime-50 dark:border-graphite-600 dark:has-[:checked]:bg-lime-400/10">
              <input type="radio" name="delivery" value="<%= v %>" class="sr-only" <%= (form.delivery || 'pickup') === v ? 'checked' : '' %>><span class="material-symbols-outlined text-base"><%= icon %></span><%= t(key) %>
            </label>
          <% }) %>
        </div>
      </fieldset>
      <label class="field"><span class="field-label"><%= t('contact.name') %> *</span><input class="input" name="name" required maxlength="120" value="<%= form.name || '' %>" autocomplete="name"></label>
      <label class="field"><span class="field-label"><%= t('contact.phone') %> *</span><input class="input" name="phone" type="tel" required maxlength="40" value="<%= form.phone || '' %>" autocomplete="tel"></label>
      <label class="field"><span class="field-label"><%= t('contact.email') %></span><input class="input" name="email" type="email" maxlength="120" value="<%= form.email || '' %>" autocomplete="email"></label>
      <label class="field"><span class="field-label"><%= t('contact.city') %></span><input class="input" name="city" maxlength="80" value="<%= form.city || '' %>"></label>
      <label class="field sm:col-span-2"><span class="field-label"><%= t('order.note') %></span><textarea class="input" name="note" maxlength="3000"><%= form.note || '' %></textarea></label>
      <div class="sm:col-span-2 flex justify-end"><button class="btn-lime px-6 py-3"><span class="material-symbols-outlined text-base">shopping_bag</span><%= t('common.send') %></button></div>
    </form>

    <aside class="space-y-4">
      <div class="card-dark p-6">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-lime-300"><%= lang === 'ka' ? 'როგორ მუშაობს შეკვეთა' : 'How ordering works' %></h2>
        <ol class="mt-4 space-y-4 text-sm">
          <% (lang === 'ka'
              ? ['აირჩიე პროდუქტი და დაგვიტოვე კონტაქტი', 'დაგიკავშირდებით და დავაზუსტებთ ფასს და ვადას', 'შემოწმებული ელემენტებისგან ვაწყობთ შენს პროდუქტს', 'მოგაწვდით ან თავად წაიღებ']
              : ['Choose a product and leave your contact', 'We call you to confirm price and lead time', 'We build it from tested cells', 'We deliver, or you pick it up']).forEach((s, i) => { %>
            <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-lime-400 font-mono text-xs font-bold text-forest-900"><%= i + 1 %></span><span class="pt-1 text-forest-100/90"><%= s %></span></li>
          <% }) %>
        </ol>
      </div>
      <div class="card card-pad text-sm text-ink-soft dark:text-forest-300">
        <span class="material-symbols-outlined text-lime-500">call</span>
        <p class="mt-2"><%= lang === 'ka' ? 'კითხვები გაქვს? დაგვირეკე:' : 'Questions? Call us:' %> <a class="font-semibold text-forest-900 hover:underline dark:text-white" href="tel:<%= site.phone.replace(/[^+\d]/g, '') %>"><%= site.phone %></a></p>
      </div>
    </aside>
  </div>
</main>
<%- include('partials/footer') %>
