<%- include('partials/head', { title: t('passport.title') }) %>
<body class="page-bg">
<%- include('partials/header') %>
<main id="main" class="container-x pt-12">
  <span class="label-mono"><%= t('passport.title') %></span>
  <% if (!cell) { %>
    <h1 class="mt-1 text-3xl font-bold text-forest-900 dark:text-white"><%= code ? t('passport.notFound') : t('passport.lookup') %></h1>
    <% if (code) { %><p class="mt-2 font-mono text-ink-soft"><%= code %></p><% } %>
    <form action="/passport" method="get" class="mt-6 flex max-w-md gap-2">
      <label for="p-code" class="sr-only"><%= t('passport.lookup') %></label>
      <input id="p-code" name="code" class="input font-mono" placeholder="<%= t('passport.lookupPh') %>" required>
      <button class="btn-lime"><%= t('passport.check') %></button>
    </form>
  <% } else { const D = cell.grade === 'D'; %>
    <div class="mt-3 grid gap-6 lg:grid-cols-[1.3fr_1fr]">
      <div class="card overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-forest-100 bg-mint-50 px-6 py-4 dark:border-graphite-600 dark:bg-graphite-850">
          <div>
            <h1 class="font-mono text-2xl font-semibold text-forest-900 dark:text-white"><%= cell.code %></h1>
            <div class="mt-1 text-sm text-ink-soft dark:text-forest-300"><%= t('passport.batch') %> · <%= fmt(cell.quantity) %> <%= t('common.pcs') %></div>
          </div>
          <span class="grade-<%= cell.grade %> !px-3 !py-1 text-sm"><%= cell.grade %></span>
        </div>
        <dl class="grid gap-px bg-forest-50 sm:grid-cols-2 dark:bg-graphite-700">
          <% [
            ['fields.chemistry', cell.chemistry === 'other' ? t('chem.other') : cell.chemistry],
            ['fields.form', cell.form_factor === 'other' ? (cell.form_other || t('form.other')) : t('form.' + cell.form_factor)],
            ['fields.capacity', fmt(cell.capacity_value, 2) + ' ' + cell.capacity_unit],
            ['fields.source', cell.source === 'other' ? (cell.source_other || t('source.other')) : t('source.' + cell.source)],
            ['fields.soh', cell.soh ? fmt(cell.soh, 1) + '%' : '—'],
            ['fields.ir', cell.internal_resistance ? fmt(cell.internal_resistance, 1) + ' mΩ' : '—'],
            ['fields.voltage', cell.voltage ? fmt(cell.voltage, 2) + ' V' : '—'],
            ['fields.receivedAt', cell.received_at],
          ].forEach(([k, v]) => { %>
            <div class="bg-white px-6 py-4 dark:bg-graphite-800"><dt class="label-mono"><%= t(k) %></dt><dd class="mt-1 font-medium text-forest-900 dark:text-white"><%= v %></dd></div>
          <% }) %>
        </dl>
        <div class="flex items-center gap-3 px-6 py-4 <%= D ? 'bg-red-50 text-red-800 dark:bg-red-950/30 dark:text-red-200' : 'bg-lime-50 text-forest-900 dark:bg-lime-400/10 dark:text-lime-200' %>">
          <span class="material-symbols-outlined"><%= D ? 'recycling' : 'battery_charging_full' %></span>
          <span class="text-sm font-semibold"><%= t('passport.status') %>: <%= D ? t('passport.recycled') : t('passport.revived') %></span>
        </div>
      </div>
      <div class="space-y-4">
        <div class="card card-pad flex items-center gap-5">
          <div class="h-32 w-32 shrink-0 rounded-xl bg-white p-2 ring-1 ring-forest-100"><%- qr %></div>
          <p class="text-sm text-ink-soft dark:text-forest-300"><%= lang === 'ka' ? 'ეს QR კოდი ელემენტის პარტიაზეა მიმაგრებული და მის მთელ ისტორიას აჩვენებს.' : 'This QR code is attached to the batch and shows its full history.' %></p>
        </div>
        <div class="card-dark p-6">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-lime-300"><%= t('passport.impact') %></h2>
          <div class="mt-4 grid grid-cols-3 gap-3">
            <div><div class="font-mono text-xl font-semibold"><%= fmt(impact.kg, 1) %></div><div class="text-xs text-forest-200/70"><%= lang === 'ka' ? 'კგ გადარჩა' : 'kg saved' %></div></div>
            <div><div class="font-mono text-xl font-semibold"><%= fmt(impact.kwh, 2) %></div><div class="text-xs text-forest-200/70">kWh</div></div>
            <div><div class="font-mono text-xl font-semibold"><%= fmt(impact.co2, 2) %></div><div class="text-xs text-forest-200/70">t CO₂</div></div>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>
