<%
  const links = [
    { href: '/', key: 'nav.home' },
    { href: '/products', key: 'nav.products' },
    { href: '/about', key: 'nav.about' },
    { href: '/contact', key: 'nav.contact' },
  ];
  const isActive = (href) => href === '/' ? path === '/' : path.startsWith(href);
%>
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-lime-400 focus:px-4 focus:py-2 focus:text-forest-900">Skip to content</a>
<header class="sticky top-0 z-50 border-b border-forest-100/70 bg-white/75 backdrop-blur-xl dark:border-graphite-600/70 dark:bg-graphite-900/75">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="shrink-0" aria-label="ENCORE"><%- include('logo', { size: 'h-9' }) %></a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      <% links.forEach(l => { %>
        <a href="<%= l.href %>" class="nav-link <%= isActive(l.href) ? 'active' : '' %>"><%= t(l.key) %></a>
      <% }) %>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center rounded-full border border-forest-100 bg-white p-0.5 text-xs font-semibold sm:flex dark:border-graphite-600 dark:bg-graphite-800" role="group" aria-label="<%= t('common.language') %>">
        <a href="/lang/ka" class="rounded-full px-2.5 py-1 <%= lang === 'ka' ? 'bg-forest-800 text-white dark:bg-lime-400 dark:text-forest-900' : 'text-forest-600 dark:text-forest-200' %>">KA</a>
        <a href="/lang/en" class="rounded-full px-2.5 py-1 <%= lang === 'en' ? 'bg-forest-800 text-white dark:bg-lime-400 dark:text-forest-900' : 'text-forest-600 dark:text-forest-200' %>">EN</a>
      </div>
      <button type="button" data-theme-toggle class="grid h-9 w-9 place-items-center rounded-full border border-forest-100 bg-white text-forest-700 transition hover:bg-mint-100 dark:border-graphite-600 dark:bg-graphite-800 dark:text-lime-300 dark:hover:bg-graphite-700" aria-label="<%= t('common.theme') %>">
        <span class="material-symbols-outlined dark:hidden">dark_mode</span>
        <span class="material-symbols-outlined hidden dark:inline">light_mode</span>
      </button>
      <a href="/order" class="btn-lime hidden sm:inline-flex"><span class="material-symbols-outlined text-base">shopping_bag</span><%= t('nav.order') %></a>
      <button type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" class="grid h-9 w-9 place-items-center rounded-full border border-forest-100 bg-white text-forest-800 lg:hidden dark:border-graphite-600 dark:bg-graphite-800 dark:text-forest-50" aria-label="<%= t('common.menu') %>">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-forest-100 bg-white px-4 pb-5 pt-3 lg:hidden dark:border-graphite-600 dark:bg-graphite-900">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      <% links.forEach(l => { %>
        <a href="<%= l.href %>" class="nav-link <%= isActive(l.href) ? 'active' : '' %>"><%= t(l.key) %></a>
      <% }) %>
    </nav>
    <div class="mt-4 flex items-center justify-between gap-3">
      <div class="flex items-center rounded-full border border-forest-100 bg-white p-0.5 text-xs font-semibold dark:border-graphite-600 dark:bg-graphite-800">
        <a href="/lang/ka" class="rounded-full px-3 py-1.5 <%= lang === 'ka' ? 'bg-forest-800 text-white dark:bg-lime-400 dark:text-forest-900' : 'text-forest-600 dark:text-forest-200' %>">KA</a>
        <a href="/lang/en" class="rounded-full px-3 py-1.5 <%= lang === 'en' ? 'bg-forest-800 text-white dark:bg-lime-400 dark:text-forest-900' : 'text-forest-600 dark:text-forest-200' %>">EN</a>
      </div>
      <a href="/order" class="btn-lime flex-1"><%= t('nav.order') %></a>
    </div>
  </div>
</header>
