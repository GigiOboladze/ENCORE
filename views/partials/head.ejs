<!doctype html>
<html lang="<%= lang %>" class="<%= theme === 'dark' ? 'dark' : '' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' — ENCORE' : 'ENCORE — ' + t('footer.tagline') %></title>
  <meta name="description" content="<%= t('about.lead') %>">
  <meta name="theme-color" content="#143A30">
  <link rel="icon" href="/static/img/favicon.png" type="image/png">
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("theme");
        var dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch (e) {}
    })();
  </script>
  <% if (locals.isStatic) { %><script>window.ENCORE_STATIC = <%- JSON.stringify({ api: staticApi, email: site.email, lang }).replace(/</g, String.fromCharCode(92) + 'u003c') %>;</script><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@800&family=JetBrains+Mono:wght@500&family=Noto+Sans+Georgian:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..600,0..1,0&display=block">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= locals.assetVersion || 1 %>">
</head>
