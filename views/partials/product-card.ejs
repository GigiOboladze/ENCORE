<article class="group card flex flex-col overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lift">
  <a href="/products/<%= p.slug %>" class="relative block aspect-[4/3] overflow-hidden bg-mint-100 dark:bg-graphite-700">
    <% if (p.photos[0]) { %>
      <img src="/uploads/<%= p.photos[0] %>" alt="<%= L(p, 'name') %>" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
    <% } else { %>
      <span class="grid h-full place-items-center text-forest-300"><span class="material-symbols-outlined text-5xl">battery_charging_full</span></span>
    <% } %>
    <% if (p.cells_needed) { %>
      <span class="absolute left-3 top-3 rounded-full bg-forest-900/80 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-lime-300 backdrop-blur"><%= fmt(p.cells_needed) %> <%= t('products.cellsInside') %></span>
    <% } %>
  </a>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-semibold text-forest-900 dark:text-white"><a href="/products/<%= p.slug %>" class="hover:text-forest-600 dark:hover:text-lime-300"><%= L(p, 'name') %></a></h3>
    <p class="mt-1.5 line-clamp-2 text-sm text-ink-soft dark:text-forest-300"><%= L(p, 'short') %></p>
    <div class="mt-auto flex items-end justify-between gap-3 pt-5">
      <div>
        <% if (p.price_from) { %>
          <% if (lang === 'ka') { %>
            <div class="font-display text-2xl font-bold text-forest-900 dark:text-white"><%= fmt(p.price_from) %> ₾<span class="text-base font-semibold">-<%= t('common.from') %></span></div>
          <% } else { %>
            <div class="font-display text-2xl font-bold text-forest-900 dark:text-white"><span class="mr-1 text-sm font-medium text-ink-soft dark:text-forest-300"><%= t('common.from') %></span><%= fmt(p.price_from) %> ₾</div>
          <% } %>
        <% } else { %>
          <div class="text-sm font-semibold text-forest-700 dark:text-forest-200"><%= t('common.priceOnRequest') %></div>
        <% } %>
      </div>
      <a href="/order?product=<%= p.slug %>" class="btn-lime btn-sm"><%= t('common.orderNow') %></a>
    </div>
  </div>
</article>
