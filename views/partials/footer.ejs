<footer class="mt-24 bg-forest-900 text-forest-100 dark:bg-graphite-950">
  <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div class="space-y-4">
      <%- include('logo', { light: true }) %>
      <p class="max-w-xs text-sm text-forest-200/80"><%= t('footer.tagline') %></p>
      <form action="/passport" method="get" class="flex max-w-xs gap-2" role="search">
        <label for="f-passport" class="sr-only"><%= t('passport.lookup') %></label>
        <input id="f-passport" name="code" placeholder="<%= t('passport.lookupPh') %>" class="w-full rounded-full border border-white/15 bg-white/5 px-4 py-2 font-mono text-xs text-white placeholder:text-forest-300 focus:border-lime-400 focus:outline-none">
        <button class="rounded-full bg-lime-400 px-3 text-forest-900" aria-label="<%= t('passport.check') %>"><span class="material-symbols-outlined">qr_code_scanner</span></button>
      </form>
    </div>

    <div>
      <h3 class="label-mono !text-lime-300"><%= t('footer.links') %></h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a class="hover:text-lime-300" href="/"><%= t('nav.home') %></a></li>
        <li><a class="hover:text-lime-300" href="/products"><%= t('nav.products') %></a></li>
        <li><a class="hover:text-lime-300" href="/about"><%= t('nav.about') %></a></li>
        <li><a class="hover:text-lime-300" href="/contact"><%= t('nav.handin') %></a></li>
        <li><a class="hover:text-lime-300" href="/order"><%= t('nav.order') %></a></li>
      </ul>
    </div>

    <div>
      <h3 class="label-mono !text-lime-300"><%= t('nav.contact') %></h3>
      <ul class="mt-4 space-y-3 text-sm">
        <li class="flex gap-2"><span class="material-symbols-outlined text-lime-300">call</span><a class="hover:text-lime-300" href="tel:<%= site.phone.replace(/[^+\d]/g, '') %>"><%= site.phone %></a></li>
        <li class="flex gap-2"><span class="material-symbols-outlined text-lime-300">mail</span><a class="hover:text-lime-300" href="mailto:<%= site.email %>"><%= site.email %></a></li>
        <li class="flex gap-2"><span class="material-symbols-outlined text-lime-300">location_on</span><span><%= L(site, 'address') %></span></li>
        <li class="flex gap-2"><span class="material-symbols-outlined text-lime-300">schedule</span><span><%= L(site, 'hours') %></span></li>
      </ul>
    </div>

    <div>
      <h3 class="label-mono !text-lime-300"><%= t('footer.follow') %></h3>
      <div class="mt-4 flex gap-2">
        <% [['facebook','Facebook','<path fill="currentColor" d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8.1v3h2.5V21h2.9Z"/>'],
            ['instagram','Instagram','<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3.8" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>'],
            ['linkedin','LinkedIn','<path fill="currentColor" d="M6.9 8.8H3.7V20h3.2V8.8ZM5.3 3.6a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.3 13.6c0-3-.7-5.1-4.2-5.1-1.7 0-2.8.9-3.2 1.8V8.8H9.8V20H13v-5.6c0-1.5.3-2.9 2.1-2.9 1.8 0 1.8 1.7 1.8 3V20h3.2v-6.4Z"/>']].forEach(([key, label, svg]) => { %>
          <a href="<%= site[key] || '#' %>" <%- site[key] ? 'target="_blank" rel="noopener"' : '' %> class="grid h-10 w-10 place-items-center rounded-full bg-white/5 ring-1 ring-white/10 transition hover:bg-lime-400 hover:text-forest-900" aria-label="<%= label %>">
            <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true"><%- svg %></svg>
          </a>
        <% }) %>
      </div>
      <a href="/contact" class="btn-lime mt-6"><span class="material-symbols-outlined text-base">battery_charging_full</span><%= t('nav.handin') %></a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-5 text-xs text-forest-300 sm:flex-row sm:items-center sm:justify-between">
      <span>© <%= new Date().getFullYear() %> ENCORE. <%= t('footer.rights') %></span>
      <span class="font-mono"><%= t('footer.hackathon') %></span>
    </div>
  </div>
</footer>
<div id="confirm-dialog" class="fixed inset-0 z-[70] hidden items-center justify-center bg-forest-950/50 p-4 backdrop-blur-sm" role="dialog" aria-modal="true">
  <div class="card card-pad w-full max-w-sm">
    <p data-confirm-text class="text-sm text-forest-800 dark:text-forest-100"></p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" data-confirm-cancel class="btn-ghost btn-sm"><%= t('common.cancel') %></button>
      <button type="button" data-confirm-ok class="btn-danger btn-sm"><%= t('common.delete') %></button>
    </div>
  </div>
</div>
<script src="/static/js/app.js" defer></script>
</body>
</html>
