<%# Horizontal bar list. Params: items [{label, value, cls}], unit %>
<% const max = Math.max(1, ...items.map(i => i.value)); %>
<ul class="space-y-3">
  <% items.forEach(i => { %>
    <li>
      <div class="mb-1 flex items-baseline justify-between gap-3 text-sm">
        <span class="truncate text-forest-800 dark:text-forest-100"><%= i.label %></span>
        <span class="shrink-0 whitespace-nowrap font-mono text-xs text-forest-600 dark:text-lime-300/80"><%= fmt(i.value, i.digits || 0) %><%= locals.unit ? ' ' + unit : '' %></span>
      </div>
      <div class="h-2.5 overflow-hidden rounded-full bg-mint-200 dark:bg-graphite-700">
        <div data-bar="h" class="h-full rounded-full transition-[width] duration-1000 ease-out <%= i.cls || 'bg-lime-400' %>" style="width: <%= Math.max(2, Math.round(i.value / max * 100)) %>%"></div>
      </div>
    </li>
  <% }) %>
</ul>
