<% const ka = lang === 'ka'; const S = { new: ka ? 'ახალი' : 'New', contacted: ka ? 'დავუკავშირდით' : 'Contacted', done: ka ? 'დასრულდა' : 'Done' }; %>
<%- include('_top', { pageTitle: ka ? 'ჩაბარება / წერილები' : 'Hand-ins & messages' }) %>
<div class="mb-4 flex flex-wrap gap-2">
  <a href="/admin/inquiries" class="nav-link <%= !type ? 'active' : '' %>"><%= t('common.all') %></a>
  <a href="/admin/inquiries?type=handin" class="nav-link <%= type === 'handin' ? 'active' : '' %>"><span class="material-symbols-outlined text-base">battery_charging_full</span> <%= ka ? 'ბატარეის ჩაბარება' : 'Battery hand-in' %></a>
  <a href="/admin/inquiries?type=contact" class="nav-link <%= type === 'contact' ? 'active' : '' %>"><span class="material-symbols-outlined text-base">mail</span> <%= ka ? 'წერილები' : 'Messages' %></a>
</div>
<div class="grid gap-4 lg:grid-cols-2">
  <% items.forEach(i => { %>
    <article class="card card-pad">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-xl <%= i.type === 'handin' ? 'bg-lime-100 text-forest-800 dark:bg-lime-400/15 dark:text-lime-300' : 'bg-sky-50 text-sky-700 dark:bg-sky-400/10 dark:text-sky-300' %>"><span class="material-symbols-outlined"><%= i.type === 'handin' ? 'battery_charging_full' : 'mail' %></span></span>
          <div><div class="font-semibold text-forest-900 dark:text-white"><%= i.name %></div><div class="font-mono text-xs text-ink-soft dark:text-forest-300"><%= i.created_at.slice(0, 16) %></div></div>
        </div>
        <span class="status-<%= i.status %>"><%= S[i.status] %></span>
      </div>
      <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
        <% if (i.phone) { %><div><dt class="label-mono"><%= t('contact.phone') %></dt><dd><a href="tel:<%= i.phone %>" class="text-forest-700 hover:underline dark:text-lime-300"><%= i.phone %></a></dd></div><% } %>
        <% if (i.email) { %><div><dt class="label-mono"><%= t('contact.email') %></dt><dd class="break-all"><a href="mailto:<%= i.email %>" class="text-forest-700 hover:underline dark:text-lime-300"><%= i.email %></a></dd></div><% } %>
        <% if (i.battery_source) { %><div><dt class="label-mono"><%= t('contact.source') %></dt><dd><%= t('source.' + i.battery_source) %></dd></div><% } %>
        <% if (i.battery_qty) { %><div><dt class="label-mono"><%= t('contact.qty') %></dt><dd><%= i.battery_qty %></dd></div><% } %>
        <% if (i.city) { %><div><dt class="label-mono"><%= t('contact.city') %></dt><dd><%= i.city %></dd></div><% } %>
      </dl>
      <% if (i.message) { %><p class="mt-3 whitespace-pre-line rounded-xl bg-mint-50 p-3 text-sm text-forest-800 dark:bg-graphite-900 dark:text-forest-100"><%= i.message %></p><% } %>
      <div class="mt-4 flex items-center justify-between gap-2">
        <form method="post" action="/admin/inquiries/<%= i.id %>/status" class="flex gap-1">
          <% statuses.forEach(s => { %><button name="status" value="<%= s %>" class="btn-sm btn <%= i.status === s ? 'bg-forest-800 text-white dark:bg-lime-400 dark:text-forest-900' : 'btn-ghost' %>"><%= S[s] %></button><% }) %>
        </form>
        <form method="post" action="/admin/inquiries/<%= i.id %>/delete" data-confirm="<%= ka ? 'წავშალო ჩანაწერი?' : 'Delete this entry?' %>"><button class="grid h-8 w-8 place-items-center rounded-full text-red-600 hover:bg-red-50 dark:hover:bg-red-950/40" aria-label="<%= t('common.delete') %>"><span class="material-symbols-outlined text-lg">delete</span></button></form>
      </div>
    </article>
  <% }) %>
</div>
<% if (!items.length) { %><p class="card card-pad text-center text-ink-soft"><%= ka ? 'ჩანაწერები ჯერ არ არის.' : 'Nothing here yet.' %></p><% } %>
<%- include('_bottom') %>
