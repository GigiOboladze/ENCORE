<% const ka = lang === 'ka'; %>
<%- include('_top', { pageTitle: ka ? 'დაშბორდი' : 'Dashboard', action: { href: '/admin/cells/new', label: ka ? 'ელემენტის დამატება' : 'Add cells' } }) %>

<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <% [
    [ka ? 'მიღებული ელემენტები' : 'Cells received', stats.received, 0, 'inventory_2', ka ? stats.batches + ' პარტია' : stats.batches + ' batches', true],
    [ka ? 'გაცოცხლებული (A–C)' : 'Revived (A–C)', stats.revived, 0, 'battery_charging_full', stats.received ? fmt(stats.revived / stats.received * 100, 0) + '%' : '0%'],
    [ka ? 'გამოყენებული პროდუქტებში' : 'Used in products', stats.used, 0, 'precision_manufacturing', stats.revived ? fmt(stats.used / stats.revived * 100, 0) + '%' : '0%'],
    [ka ? 'გადამუშავებაზე (D)' : 'To recycling (D)', stats.recycled, 0, 'recycling', ka ? 'მგვ ჯაჭვი' : 'EPR chain'],
  ].forEach(([label, v, d, icon, sub, dark]) => { %>
    <div class="<%= dark ? 'card-dark' : 'card' %> p-5">
      <div class="flex items-center justify-between">
        <span class="<%= dark ? 'font-mono text-[11px] uppercase tracking-[0.14em] text-lime-300' : 'label-mono' %>"><%= label %></span>
        <span class="material-symbols-outlined <%= dark ? 'text-lime-300' : 'text-forest-300 dark:text-forest-500' %>"><%= icon %></span>
      </div>
      <div class="mt-3 font-mono text-3xl font-semibold <%= dark ? 'text-white' : 'text-forest-900 dark:text-white' %>" data-count="<%= v %>" data-digits="<%= d %>"><%= fmt(v, d) %></div>
      <div class="mt-1 text-xs <%= dark ? 'text-forest-200/70' : 'text-ink-soft dark:text-forest-300' %>"><%= sub %></div>
    </div>
  <% }) %>
</section>

<section class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <% [
    ['kWh ' + (ka ? 'მეორე სიცოცხლეში' : 'in second life'), stats.revivedKwh, 1, 'bolt'],
    [ka ? 'კგ გადარჩა ნაგავსაყრელს' : 'kg kept from landfill', stats.kgSaved, 0, 'delete_forever'],
    [ka ? 'ტ CO₂ თავიდან აცილებული' : 't CO₂ avoided', stats.co2Tonnes, 2, 'co2'],
    [ka ? 'მარაგის ღირებულება (₾)' : 'Inventory value (₾)', stats.inventoryValue, 0, 'payments'],
  ].forEach(([label, v, d, icon]) => { %>
    <div class="card p-5">
      <div class="flex items-center justify-between"><span class="label-mono"><%= label %></span><span class="material-symbols-outlined text-forest-300 dark:text-forest-500"><%= icon %></span></div>
      <div class="mt-3 font-mono text-2xl font-semibold text-forest-900 dark:text-white" data-count="<%= v %>" data-digits="<%= d %>"><%= fmt(v, d) %></div>
    </div>
  <% }) %>
</section>

<section class="mt-6 grid gap-4 xl:grid-cols-3">
  <div class="card card-pad">
    <h2 class="font-semibold text-forest-900 dark:text-white"><%= t('stats.bySource') %></h2>
    <div class="mt-5"><%- include('../partials/bars', { items: C.SOURCES.filter(s => stats.bySource[s]).map(s => ({ label: t('source.' + s), value: stats.bySource[s] })).sort((a,b) => b.value - a.value).map((x, i) => ({ ...x, cls: i === 0 ? 'bg-lime-400' : 'bg-forest-600/80 dark:bg-forest-500' })), unit: t('common.pcs') }) %></div>
  </div>
  <div class="card card-pad">
    <h2 class="font-semibold text-forest-900 dark:text-white"><%= t('stats.byGrade') %></h2>
    <div class="mt-5"><%- include('../partials/bars', { items: C.GRADES.map(g => ({ label: t('grade.' + g), value: stats.byGrade[g] || 0, cls: 'bar-' + g })), unit: t('common.pcs') }) %></div>
  </div>
  <div class="card card-pad">
    <h2 class="font-semibold text-forest-900 dark:text-white"><%= t('stats.byMonth') %></h2>
    <div class="mt-5"><%- include('../partials/columns', { items: stats.months.map(m => ({ label: m.key.slice(5) + '/' + m.key.slice(2, 4), value: m.value })) }) %></div>
  </div>
</section>

<section class="mt-4 grid gap-4 xl:grid-cols-[1fr_2fr]">
  <div class="card card-pad">
    <h2 class="font-semibold text-forest-900 dark:text-white"><%= t('stats.byChemistry') %></h2>
    <div class="mt-5"><%- include('../partials/bars', { items: Object.entries(stats.byChemistry).sort((a,b) => b[1]-a[1]).map(([k, v]) => ({ label: k === 'other' ? t('chem.other') : k, value: v, cls: 'bg-forest-600/80 dark:bg-forest-500' })), unit: t('common.pcs') }) %></div>
    <div class="mt-6 grid grid-cols-2 gap-3 border-t border-forest-100 pt-4 text-sm dark:border-graphite-600">
      <a href="/admin/orders" class="rounded-xl bg-mint-50 p-3 hover:bg-mint-100 dark:bg-graphite-900 dark:hover:bg-graphite-700"><div class="font-mono text-xl font-semibold text-forest-900 dark:text-white"><%= stats.openOrders %></div><div class="text-xs text-ink-soft dark:text-forest-300"><%= ka ? 'აქტიური შეკვეთა' : 'Open orders' %></div></a>
      <a href="/admin/inquiries" class="rounded-xl bg-mint-50 p-3 hover:bg-mint-100 dark:bg-graphite-900 dark:hover:bg-graphite-700"><div class="font-mono text-xl font-semibold text-forest-900 dark:text-white"><%= stats.newInquiries %></div><div class="text-xs text-ink-soft dark:text-forest-300"><%= ka ? 'ახალი მოთხოვნა' : 'New requests' %></div></a>
    </div>
  </div>
  <div class="card overflow-hidden">
    <div class="flex items-center justify-between border-b border-forest-100 px-5 py-4 dark:border-graphite-600">
      <h2 class="font-semibold text-forest-900 dark:text-white"><%= ka ? 'ბოლო პარტიები' : 'Recent batches' %></h2>
      <a href="/admin/cells" class="text-sm font-medium text-forest-600 hover:underline dark:text-lime-300"><%= ka ? 'ყველა' : 'View all' %> →</a>
    </div>
    <div class="overflow-x-auto">
      <table class="tbl">
        <thead><tr><th><%= t('fields.code') %></th><th><%= t('fields.source') %></th><th><%= t('fields.form') %></th><th class="text-right"><%= t('fields.quantity') %></th><th><%= t('fields.grade') %></th><th><%= t('fields.receivedAt') %></th></tr></thead>
        <tbody>
          <% recent.forEach(c => { %>
            <tr>
              <td class="whitespace-nowrap"><a href="/admin/cells/<%= c.id %>" class="font-mono text-xs font-semibold text-forest-800 hover:underline dark:text-lime-300"><%= c.code %></a></td>
              <td><%= c.source === 'other' ? (c.source_other || t('source.other')) : t('source.' + c.source) %></td>
              <td class="whitespace-nowrap"><span class="font-mono text-xs"><%= c.chemistry %> · <%= c.form_factor === 'other' ? (c.form_other || '—') : c.form_factor %></span></td>
              <td class="text-right font-mono"><%= fmt(c.quantity) %></td>
              <td><span class="grade-<%= c.grade %>"><%= c.grade %></span></td>
              <td class="whitespace-nowrap font-mono text-xs text-ink-soft dark:text-forest-300"><%= c.received_at %></td>
            </tr>
          <% }) %>
          <% if (!recent.length) { %><tr><td colspan="6" class="py-8 text-center text-ink-soft"><%= ka ? 'ჯერ არცერთი პარტია არ არის.' : 'No batches yet.' %></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<%- include('_bottom') %>
