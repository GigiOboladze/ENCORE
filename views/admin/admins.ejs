<% const ka = lang === 'ka'; %>
<%- include('_top', { pageTitle: ka ? 'ადმინები' : 'Admins' }) %>
<div class="grid gap-5 xl:grid-cols-[1fr_360px]">
  <div class="table-wrap self-start">
    <table class="tbl">
      <thead><tr><th><%= ka ? 'მომხმარებელი' : 'Username' %></th><th><%= ka ? 'როლი' : 'Role' %></th><th><%= ka ? 'შექმნილია' : 'Created' %></th><th><%= ka ? 'პაროლის შეცვლა' : 'Reset password' %></th><th></th></tr></thead>
      <tbody>
        <% admins.forEach(a => { %>
          <tr>
            <td class="font-medium"><span class="inline-flex items-center gap-2"><span class="material-symbols-outlined text-forest-400">account_circle</span><%= a.username %><% if (a.id === admin.id) { %><span class="chip bg-mint-100 text-forest-700 dark:bg-graphite-700 dark:text-forest-200"><%= ka ? 'შენ' : 'you' %></span><% } %></span></td>
            <td><span class="<%= a.role === 'super' ? 'chip bg-lime-300 text-forest-900' : 'chip bg-mint-100 text-forest-700 dark:bg-graphite-700 dark:text-forest-200' %>"><%= a.role === 'super' ? 'Super admin' : 'Admin' %></span></td>
            <td class="whitespace-nowrap font-mono text-xs text-ink-soft dark:text-forest-300"><%= a.created_at.slice(0, 10) %></td>
            <td>
              <form method="post" action="/admin/admins/<%= a.id %>/password" class="flex gap-2">
                <input class="input !w-40 !py-1.5 text-xs" type="password" name="password" minlength="8" required placeholder="<%= ka ? 'ახალი პაროლი' : 'New password' %>" autocomplete="new-password" aria-label="<%= ka ? 'ახალი პაროლი' : 'New password' %>">
                <button class="btn-ghost btn-sm"><%= t('common.save') %></button>
              </form>
            </td>
            <td><% if (a.id !== admin.id) { %><form method="post" action="/admin/admins/<%= a.id %>/delete" data-confirm="<%= ka ? 'წავშალო ადმინი ' + a.username + '?' : 'Delete admin ' + a.username + '?' %>"><button class="grid h-8 w-8 place-items-center rounded-full text-red-600 hover:bg-red-50 dark:hover:bg-red-950/40" aria-label="<%= t('common.delete') %>"><span class="material-symbols-outlined text-lg">delete</span></button></form><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <form method="post" action="/admin/admins" class="card card-pad space-y-4 self-start">
    <div class="flex items-center justify-between">
      <h2 class="font-semibold text-forest-900 dark:text-white"><%= ka ? 'ახალი ადმინი' : 'New admin' %></h2>
      <span class="font-mono text-xs text-ink-soft dark:text-forest-300"><%= admins.length %>/<%= max %></span>
    </div>
    <% if (error) { %><div class="rounded-xl bg-red-50 p-3 text-sm text-red-800 dark:bg-red-950/40 dark:text-red-200" role="alert"><%= error %></div><% } %>
    <% if (admins.length >= max) { %>
      <p class="rounded-xl bg-amber-50 p-3 text-sm text-amber-900 dark:bg-amber-400/10 dark:text-amber-200"><%= ka ? 'მიღწეულია ადმინების მაქსიმალური რაოდენობა (' + max + ').' : 'Maximum number of admins reached (' + max + ').' %></p>
    <% } else { %>
      <label class="field"><span class="field-label"><%= ka ? 'მომხმარებელი' : 'Username' %></span><input class="input" name="username" required pattern="[A-Za-z0-9._\-]{3,40}" autocomplete="off"><span class="field-hint"><%= ka ? 'ლათინური ასოები, ციფრები, . _ -' : 'Latin letters, digits, . _ -' %></span></label>
      <label class="field"><span class="field-label"><%= ka ? 'პაროლი' : 'Password' %></span><input class="input" name="password" type="password" minlength="8" required autocomplete="new-password"><span class="field-hint"><%= ka ? 'მინიმუმ 8 სიმბოლო' : 'At least 8 characters' %></span></label>
      <label class="field"><span class="field-label"><%= ka ? 'როლი' : 'Role' %></span><select class="input" name="role"><option value="admin">Admin</option><option value="super">Super admin</option></select><span class="field-hint"><%= ka ? 'Super admin-ს შეუძლია ადმინების მართვა' : 'Super admins can manage admins' %></span></label>
      <button class="btn-lime w-full"><span class="material-symbols-outlined text-base">person_add</span><%= ka ? 'ადმინის შექმნა' : 'Create admin' %></button>
    <% } %>
  </form>
</div>
<%- include('_bottom') %>
