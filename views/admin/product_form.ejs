<% const ka = lang === 'ka'; const editing = Boolean(p.id); const v = (k) => p[k] == null ? '' : p[k]; %>
<%- include('_top', { pageTitle: editing ? (ka ? 'პროდუქტის რედაქტირება' : 'Edit product') : (ka ? 'ახალი პროდუქტი' : 'New product') }) %>
<a href="/admin/products" class="mb-4 inline-flex items-center gap-1 text-sm font-medium text-forest-600 hover:text-forest-900 dark:text-forest-300 dark:hover:text-lime-300"><span class="material-symbols-outlined text-base">arrow_back</span><%= t('common.back') %></a>
<% if (errors.length) { %><div class="mb-4 rounded-xl bg-red-50 p-4 text-sm text-red-800 dark:bg-red-950/40 dark:text-red-200" role="alert"><% errors.forEach(e => { %><div><%= e %></div><% }) %></div><% } %>

<form method="post" action="<%= editing ? '/admin/products/' + p.id : '/admin/products' %>" enctype="multipart/form-data" class="grid grid-cols-1 gap-5 xl:grid-cols-[1fr_340px]">
  <div class="space-y-5">
    <section class="card card-pad">
      <h2 class="label-mono">01 · <%= ka ? 'სახელი და აღწერა' : 'Name and description' %></h2>
      <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
        <% [['ka','ქართული'],['en','English']].forEach(([l, label]) => { %>
          <div class="space-y-4 rounded-xl bg-mint-50 p-4 dark:bg-graphite-900">
            <div class="font-mono text-xs font-semibold uppercase tracking-wider text-forest-600 dark:text-lime-300"><%= label %></div>
            <label class="field"><span class="field-label"><%= ka ? 'სახელი' : 'Name' %> *</span><input class="input" name="name_<%= l %>" required maxlength="160" value="<%= v('name_' + l) %>"></label>
            <label class="field"><span class="field-label"><%= ka ? 'მოკლე აღწერა' : 'Short description' %></span><textarea class="input !min-h-[70px]" name="short_<%= l %>" maxlength="400"><%= v('short_' + l) %></textarea></label>
            <label class="field"><span class="field-label"><%= ka ? 'სრული აღწერა' : 'Full description' %></span><textarea class="input" name="desc_<%= l %>" maxlength="5000"><%= v('desc_' + l) %></textarea></label>
            <label class="field"><span class="field-label"><%= ka ? 'მახასიათებლები' : 'Specifications' %></span><textarea class="input font-mono text-xs" name="specs_<%= l %>" maxlength="3000" placeholder="<%= ka ? 'ტევადობა: 5 kWh' : 'Capacity: 5 kWh' %>"><%= v('specs_' + l) %></textarea><span class="field-hint"><%= ka ? 'თითო ხაზზე ერთი: „სახელი: მნიშვნელობა“' : 'One per line: "Label: value"' %></span></label>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="card card-pad">
      <h2 class="label-mono">02 · <%= ka ? 'ფოტოები (მაქს. 3)' : 'Photos (max 3)' %></h2>
      <% if (p.photos.length) { %>
        <div class="mt-4 flex flex-wrap gap-3">
          <% p.photos.forEach(ph => { %>
            <label class="group relative cursor-pointer">
              <img src="/uploads/<%= ph %>" alt="" class="h-28 w-28 rounded-xl object-cover ring-1 ring-forest-100 dark:ring-graphite-600">
              <span class="absolute inset-x-1 bottom-1 flex items-center gap-1 rounded-lg bg-white/95 px-2 py-1 text-[11px] text-red-700"><input type="checkbox" name="remove_photos" value="<%= ph %>"> <%= t('common.delete') %></span>
            </label>
          <% }) %>
        </div>
      <% } %>
      <label class="mt-4 flex cursor-pointer items-center gap-3 rounded-xl border-2 border-dashed border-forest-200 p-4 text-sm text-forest-700 transition hover:border-lime-400 hover:bg-lime-50 dark:border-graphite-500 dark:text-forest-200 dark:hover:bg-lime-400/5">
        <span class="material-symbols-outlined text-2xl text-lime-500">add_photo_alternate</span>
        <span><%= ka ? 'დაამატე ფოტოები (სულ მაქსიმუმ 3 · JPG, PNG, WEBP · 6MB-მდე)' : 'Add photos (3 in total · JPG, PNG, WEBP · up to 6MB)' %></span>
        <input type="file" name="photos" multiple accept="image/jpeg,image/png,image/webp" class="sr-only" data-preview="photos-preview" data-max="3">
      </label>
      <div id="photos-preview" class="mt-3 flex gap-2"></div>
    </section>
  </div>

  <aside class="space-y-4 xl:sticky xl:top-24 xl:self-start">
    <div class="card card-pad space-y-4">
      <h2 class="label-mono">03 · <%= ka ? 'ფასი და პარამეტრები' : 'Price and settings' %></h2>
      <label class="field"><span class="field-label"><%= ka ? 'ფასი „-დან“ (₾)' : 'Price "from" (₾)' %></span><input class="input" name="price_from" inputmode="decimal" value="<%= v('price_from') %>"><span class="field-hint"><%= ka ? 'ცარიელი = „ფასი მოთხოვნით“' : 'Empty = "Price on request"' %></span></label>
      <label class="field"><span class="field-label"><%= ka ? 'ელემენტების რაოდენობა' : 'Cells inside' %></span><input class="input" name="cells_needed" type="number" min="0" value="<%= v('cells_needed') %>"></label>
      <label class="field"><span class="field-label"><%= ka ? 'რიგითობა' : 'Sort order' %></span><input class="input" name="sort_order" type="number" value="<%= v('sort_order') || 0 %>"></label>
      <label class="field"><span class="field-label">URL (slug)</span><input class="input font-mono text-xs" name="slug" maxlength="60" value="<%= v('slug') %>" placeholder="encore-home"></label>
      <label class="flex items-center gap-2 text-sm font-medium text-forest-800 dark:text-forest-100"><input type="checkbox" name="active" value="1" <%= p.active ? 'checked' : '' %> class="h-4 w-4 rounded accent-lime-500"> <%= ka ? 'ჩანს საიტზე' : 'Visible on site' %></label>
      <button class="btn-lime w-full py-3"><span class="material-symbols-outlined text-base">save</span><%= t('common.save') %></button>
    </div>
  </aside>
</form>
<% if (editing) { %>
  <form method="post" action="/admin/products/<%= p.id %>/delete" class="mt-6" data-confirm="<%= ka ? 'წავშალო პროდუქტი?' : 'Delete this product?' %>"><button class="btn-danger"><span class="material-symbols-outlined text-base">delete</span><%= ka ? 'პროდუქტის წაშლა' : 'Delete product' %></button></form>
<% } %>
<%- include('_bottom') %>
