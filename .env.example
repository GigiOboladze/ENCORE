# Copy to .env for local development. On Railway, add these under the service's Variables.
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=change-me-strong-password
SESSION_SECRET=long-random-string
# Railway: mount a Volume at /data and set DATA_DIR=/data so the database and uploads persist.
DATA_DIR=
# Set to false to start with no demo cell batches.
SEED_DEMO_CELLS=true
